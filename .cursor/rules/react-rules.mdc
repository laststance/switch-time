## React 19+ Quick Reference

### `Suspense + use()` - Data Fetching

```tsx
// ❌ LEGACY: Manual loading orchestration
function UserProfile({ userId }) {
  const [user, setUser] = useState(null)
  const [loading, setLoading] = useState(true)
  const [error, setError] = useState(null)

  useEffect(() => {
    setLoading(true)
    fetchUser(userId)
      .then(setUser)
      .catch(setError)
      .finally(() => setLoading(false))
  }, [userId])

  if (loading) return <Skeleton />
  if (error) return <Error />
  return <Profile user={user} />
}

// ✅ MODERN: Declarative with Suspense
function UserProfile({ userPromise }: { userPromise: Promise<User> }) {
  const user = use(userPromise)
  return <Profile user={user} />
}

// Usage
<ErrorBoundary fallback={<Error />}>
  <Suspense fallback={<Skeleton />}>
    <UserProfile userPromise={fetchUser(userId)} />
  </Suspense>
</ErrorBoundary>
```

### `<Activity>` - State Preservation

```tsx
<Activity mode={isVisible ? 'visible' : 'hidden'}>
  <Sidebar /> {/* State persists across visibility changes */}
</Activity>
```

### `use()` - Context After Early Return

```tsx
function Heading({ children }: { children?: React.ReactNode }) {
  if (!children) return null
  const theme = use(ThemeContext) // ✅ Works after early return
  return <h1 style={{ color: theme.color }}>{children}</h1>
}
```

### `useOptimistic` - Instant UI Feedback

```tsx
const [optimistic, setOptimistic] = useOptimistic(items)
startTransition(async () => {
  setOptimistic([...items, newItem]) // Instant update
  await saveItem(newItem) // Auto-reverts on error
})
```

### `useTransition` - Non-blocking Updates

```tsx
const [isPending, startTransition] = useTransition()
startTransition(() => setExpensiveState(value)) // UI stays responsive
```

### `useSyncExternalStore` - External Subscriptions

```tsx
const width = useSyncExternalStore(
  (cb) => { window.addEventListener('resize', cb); return () => window.removeEventListener('resize', cb) },
  () => window.innerWidth,
  () => 0 // SSR fallback
)
```

### `useEffectEvent` - Stable Effect Callbacks

```tsx
const onConnected = useEffectEvent(() => notify(theme)) // Always reads latest
useEffect(() => { conn.on('connected', onConnected) }, [roomId]) // Only roomId triggers
```

