# Copy to .env — `docker compose up` reads it (the api service overrides the DB host to `db`),
# and `pnpm --filter api dev` loads it on the host, where Postgres is reachable at localhost.
DATABASE_URL=postgres://switchtime:switchtime@localhost:5432/switchtime
TEST_DATABASE_URL=postgres://switchtime:switchtime@localhost:5432/switchtime_test
PORT=4100
APP_ORIGIN=http://localhost:4101
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional, both or neither: with them the API mails a link to confirm an address and one to reset a password;
# without them sign-up and sign-in work as before. A local catcher such as `npx maildev` listens on smtp://localhost:1025
# (from the Compose API, reach the host as smtp://host.docker.internal:1025).
# SMTP_URL=smtp://localhost:1025
# MAIL_FROM="Switch Time <no-reply@example.com>"
