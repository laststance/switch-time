{
  // Expo's base provides jsx, DOM lib, bundler resolution and the Metro-compatible module settings.
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "scripts/**/*.mts",
    "vitest.config.mts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
