{
  "name": "@switch-time/app",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --port 4101",
    "web": "expo start --web --port 4101",
    "build": "pnpm build:web",
    "build:web": "expo export -p web --clear",
    "typecheck": "tsc -p tsconfig.json",
    "audit:web": "node scripts/audit-web-export.mts",
    "zones:generate": "node scripts/generate-time-zones.mts && prettier --write src/lib/time-zone-catalog.ts",
    "test": "vitest run",
    "test:e2e": "expo export -p web --clear && playwright test"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.7",
    "@laststance/redux-storage-middleware": "0.4.0",
    "@orpc/client": "1.15.4",
    "@orpc/tanstack-query": "1.15.4",
    "@reduxjs/toolkit": "2.13.0",
    "@switch-time/shared": "workspace:*",
    "@tanstack/react-query": "5.104.1",
    "better-auth": "1.7.7",
    "clsx": "2.1.1",
    "expo": "57.0.26",
    "expo-constants": "57.0.20",
    "expo-linking": "57.0.11",
    "expo-network": "57.0.2",
    "expo-router": "57.0.24",
    "expo-secure-store": "57.0.4",
    "expo-web-browser": "57.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.87.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.28.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "0.21.3",
    "react-redux": "9.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "uniwind": "1.12.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@switch-time/api": "workspace:*",
    "@types/mailparser": "3.9.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/smtp-server": "3.5.13",
    "mailparser": "3.9.33",
    "smtp-server": "3.19.16",
    "typescript": "~7.0.2",
    "vitest": "5.0.3",
    "whatwg-fetch": "3.6.20"
  }
}
