{
  "name": "@switch-time/app",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --port 4101",
    "web": "expo start --web --port 4101",
    "build": "pnpm build:web",
    "build:web": "expo export -p web --clear",
    "typecheck": "tsc -p tsconfig.json",
    "audit:web": "node scripts/audit-web-export.mts",
    "zones:generate": "node scripts/generate-time-zones.mts && prettier --write src/lib/time-zone-catalog.ts",
    "test": "vitest run",
    "test:e2e": "expo export -p web --clear && playwright test"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.14",
    "@laststance/redux-storage-middleware": "0.5.1",
    "@orpc/client": "1.16.1",
    "@orpc/tanstack-query": "1.16.1",
    "@reduxjs/toolkit": "2.13.0",
    "@switch-time/shared": "workspace:*",
    "@tanstack/react-query": "5.105.0",
    "better-auth": "1.7.14",
    "clsx": "2.1.1",
    "expo": "58.0.21",
    "expo-constants": "58.0.14",
    "expo-linking": "58.0.15",
    "expo-network": "58.0.4",
    "expo-router": "58.0.28",
    "expo-secure-store": "58.0.2",
    "expo-web-browser": "58.0.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.0",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "0.21.4",
    "react-redux": "9.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "uniwind": "1.13.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@switch-time/api": "workspace:*",
    "@types/mailparser": "3.9.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/smtp-server": "3.5.13",
    "mailparser": "3.14.1",
    "smtp-server": "3.21.3",
    "typescript": "~7.0.2",
    "vitest": "5.0.5",
    "whatwg-fetch": "3.6.20"
  }
}
