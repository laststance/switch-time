{
  "name": "@switch-time/app",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --port 4101",
    "web": "expo start --web --port 4101",
    "build": "pnpm build:web",
    "build:web": "expo export -p web --clear",
    "typecheck": "tsc -p tsconfig.json",
    "audit:web": "node scripts/audit-web-export.mts",
    "test": "vitest run",
    "test:e2e": "expo export -p web --clear && playwright test"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.5",
    "@orpc/client": "1.15.2",
    "@orpc/tanstack-query": "1.15.2",
    "@reduxjs/toolkit": "2.12.0",
    "@switch-time/shared": "workspace:*",
    "@tanstack/react-query": "5.103.2",
    "better-auth": "1.7.5",
    "clsx": "2.1.1",
    "expo": "57.0.24",
    "expo-constants": "57.0.19",
    "expo-linking": "57.0.10",
    "expo-network": "57.0.2",
    "expo-router": "57.0.22",
    "expo-secure-store": "57.0.4",
    "expo-web-browser": "57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.2",
    "react-redux": "9.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "uniwind": "1.12.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@switch-time/api": "workspace:*",
    "@types/node": "26.6.2",
    "@types/react": "19.2.18",
    "typescript": "~6.0.3",
    "vitest": "5.0.1",
    "whatwg-fetch": "3.6.20"
  }
