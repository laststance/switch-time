    "@better-auth/expo": "1.7.3",
    "@hono/node-server": "2.1.1",
    "@orpc/client": "1.15.0",
    "@orpc/server": "1.15.0",
    "better-auth": "1.7.3",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "4.13.7",
    "pg": "8.23.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "drizzle-kit": "1.0.0-rc.4",
    "tsdown": "0.23.0",
    "tsx": "4.23.13",
    "typescript": "~6.0.3",
    "vitest": "5.0.0"
  }
