    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.12",
    "@better-auth/expo": "1.7.12",
    "@hono/node-server": "2.1.5",
    "@orpc/client": "1.16.1",
    "@orpc/server": "1.16.1",
    "@switch-time/shared": "workspace:*",
    "better-auth": "1.7.12",
    "drizzle-orm": "1.0.0-rc.5",
    "hono": "4.13.13",
    "nodemailer": "10.2.1",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "1.0.0-rc.5",
    "tsdown": "0.23.2",
    "tsx": "4.23.15",
    "typescript": "~7.0.2",
    "vitest": "5.0.5"
  }
